{
  "name": "@quarangate/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production-smoke": "node tests/production-smoke.mjs",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "motion": "13.4.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.10.1",
    "@biomejs/biome": "2.5.14",
    "vitest": "5.0.2",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  }
}
