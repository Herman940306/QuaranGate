# Copy to .env and fill in. NEVER commit .env.

# Port published on 127.0.0.1 for the MCP gateway
BRIDGE_PORT=8787

# Public base URL of the gateway as clients see it (used in OAuth metadata).
# Local testing: http://127.0.0.1:8787 ; behind a tunnel: https://your.domain
BRIDGE_PUBLIC_URL=http://127.0.0.1:8787

# Shared secret between gateway and executor. Generate with:
#   openssl rand -base64 32
INTERNAL_TOKEN=<SET_SECURELY>

# GID of the 'docker' group that owns /var/run/docker.sock (see: stat -c %g /var/run/docker.sock)
DOCKER_GID=1001

# Client API keys are NOT stored here. Generate with: npm run gen-key -- <client-id>
# which prints the key once and stores only its hash in config/clients.yaml.
