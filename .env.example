# Copy to .env and fill in. NEVER commit .env.

# Port published on 127.0.0.1 for the MCP gateway
BRIDGE_PORT=8787

# Public origin of the gateway as clients see it (OAuth + SH-01 Host/Origin admission).
# Origin only: no path/query/fragment. Non-loopback deployments MUST use HTTPS.
# Local testing: http://127.0.0.1:8787 ; behind a tunnel: https://your.domain
BRIDGE_PUBLIC_URL=http://127.0.0.1:8787

# Shared secret between gateway and executor. Generate with:
#   openssl rand -base64 32
INTERNAL_TOKEN=<SET_SECURELY>

# Separate least-privilege credential between executor and the private
# Docker-authority broker. It MUST be independently generated and MUST NOT equal
# INTERNAL_TOKEN; reusing the gateway/executor token is refused by the broker client.
#   openssl rand -base64 32
DOCKER_AUTHORITY_TOKEN=<SET_DISTINCT_SECURELY>

# BE9 product-assessment service identities. Generate each independently; do not
# reuse INTERNAL_TOKEN, DOCKER_AUTHORITY_TOKEN, browser/session tokens, or each other.
# Leave unset only when the corresponding product-assessment surface is intentionally
# unavailable. No secret value belongs in source control.
#   openssl rand -base64 32
PRODUCT_ASSESSMENT_BRIDGE_TOKEN=
#   openssl rand -base64 32
PRODUCT_ASSESSMENT_MCP_TOKEN=

# Gateway -> product internal service origin used only by BE9 MCP assessment tools.
# Must be an origin (no credentials/path/query/fragment) reachable from gateway.
QG_PRODUCT_INTERNAL_URL=
# Product service -> Gateway origin for the narrow BE9 admission bridge. This is
# consumed by the product/Next.js deployment, not as caller/browser authority.
QG_PRODUCT_GATEWAY_URL=

# GID of the 'docker' group that owns /var/run/docker.sock (see: stat -c %g /var/run/docker.sock)
DOCKER_GID=1001

# ---------------------------------------------------------------------------
# Immutable production image pins (docs/operations/OPERATIONS.md "Image provenance").
#
# These MUST be set here — in the deployment directory's .env — and never
# passed as one-off inline/exported shell variables. A value that lives only
# in the shell that happened to run `docker compose up` does not survive a
# fresh shell, a restart, or a move to another checkout. SH-06 removes the
# mutable production fallback entirely; missing persisted identity fails closed.
#
# `remote-owner-deploy-candidate.sh` owns these persisted selections. Manual
# production starts must provide all three service refs and all three image IDs;
# there is no mutable or unset production fallback in compose.yaml.
GIT_REVISION=<full reviewed commit sha>
# SH-06: primary QuaranGate services use service-specific reviewed tags plus
# the exact immutable Docker image ID those tags resolved to at deployment.
# All three service tags intentionally bind to the same shared QuaranGate artifact.
GATEWAY_IMAGE=quarangate:gateway-<full reviewed commit sha>
GATEWAY_IMAGE_ID=sha256:<64 lowercase hex from docker image inspect>
DOCKER_AUTHORITY_IMAGE=quarangate:docker-authority-<full reviewed commit sha>
DOCKER_AUTHORITY_IMAGE_ID=sha256:<same shared image id>
EXECUTOR_IMAGE=quarangate:executor-<full reviewed commit sha>
EXECUTOR_IMAGE_ID=sha256:<same shared image id>

# Absolute path to the verified, lock-specific npm bundle directory used only
# for source builds. It must contain manifest.json and tarballs/ directly.
# Example: /path/to/quarangate/build-artifacts/npm/<package-lock-sha256>
QUARANGATE_NPM_BUNDLE_PATH=<absolute path to verified npm bundle>

# Client API keys are NOT stored here. Generate with: npm run gen-key -- <client-id>
# which prints the key once and stores only its hash in config/clients.yaml.
# ---------------------------------------------------------------------------
# A4 real read-only Kiro backend (OPTIONAL). Leave unset to keep the deployed
# executor fake-only. When AGENT_RUNNER_IMAGE + AGENT_PROXY_IMAGE +
# AGENT_KIRO_KEY_PATH are all set, backend=kiro resolves to the real KiroBackend
# (audit/plan/review plus governed implement sandbox; apply remains separate). None are caller-selectable.

# Real runner image (MUST contain kiro-cli + kiro-cli-chat). NEVER the :a4-test stub.
AGENT_RUNNER_IMAGE=mcp-ide-bridge-kiro-runner:a4
# Image used for the bridge-controlled egress proxy (the bridge image itself —
# it contains the compiled proxy; runs with no docker.sock, no key, no source).
# In production pin the same immutable tag as the executor:
#   AGENT_PROXY_IMAGE=quarangate:executor-<full reviewed commit sha>
AGENT_PROXY_IMAGE=quarangate:executor-<full reviewed commit sha>
# Executor-internal path of the RO Kiro key FILE (delivered via the compose
# secret 'kiro_api_key'). This is a PATH, never the secret value.
AGENT_KIRO_KEY_PATH=/run/secrets/kiro-api-key
# Host file that backs the compose secret (read-only, executor-only). N1D moved
# this to the QuaranGate path (§47.8). Leave UNSET to let compose use the new
# default, or resolve it explicitly with new-path-first/legacy-fallback:
#   AGENT_KIRO_KEY_FILE=$(node scripts/resolve-kiro-key-file.mjs)
# The selected file must be a regular non-symlink owned by uid 1000 with exact
# mode 0600. Candidate deployment verifies this metadata before Compose starts.
AGENT_KIRO_KEY_FILE=/home/herman/.config/quarangate/kiro-api-key
# Zero-inference verification switch: when truthy the real backend stops after
# ACP session/new (no model turn). Parsed in src/executor/index.ts as
# /^(1|true|yes)$/i, so `false` is the explicit canonical NON-dry-run value.
# State it explicitly rather than relying on an empty/absent ambient value.
AGENT_KIRO_DRY_RUN=false

# ---------------------------------------------------------------------------
# A7 GitHub Copilot CLI ACP backend (OPTIONAL SOURCE; LIVE QUALIFICATION DEFERRED).
# Load compose.copilot.yaml only when intentionally enabling the backend.
AGENT_COPILOT_RUNNER_IMAGE=<SET_PINNED_COPILOT_CLI_RUNNER_IMAGE>
AGENT_COPILOT_HELPER_IMAGE=<SET_PINNED_HELPER_IMAGE>
AGENT_COPILOT_KEY_FILE=<SET_OWNER_CONTROLLED_COPILOT_CREDENTIAL_FILE>
AGENT_COPILOT_MODEL=<SET_OWNER_APPROVED_MODEL>
AGENT_COPILOT_EGRESS_HOSTS=<SET_OWNER_APPROVED_EXACT_HOSTNAMES>
AGENT_COPILOT_DRY_RUN=false

# ---------------------------------------------------------------------------
# GitHub App control plane (OPTIONAL).
# Deploy with compose.github.yaml only after config/github.yaml exists and the
# App is installed on the explicitly registered repositories.
# ---------------------------------------------------------------------------
# GitHub App Client ID (recommended JWT issuer; not secret).
GITHUB_APP_CLIENT_ID=<SET_GITHUB_APP_CLIENT_ID>
# Host path to the App private key PEM. Keep 0600 and never commit it.
GITHUB_APP_PRIVATE_KEY_FILE=/home/herman/.config/quarangate/github-app-private-key.pem
# Exact locally available Git-capable helper image used only for bounded HTTPS
# push. Never :latest. It receives source RO + a one-operation token volume and
# no Docker socket.
GITHUB_GIT_HELPER_IMAGE=<SET_EXACT_GIT_CAPABLE_IMAGE>

# ---------------------------------------------------------------------------
# O1 Ollama read-only backend (OPTIONAL). Leave OLLAMA_MODEL_QUALIFIER unset
# and Ollama disabled in agents.yaml to keep the executor Ollama-inactive.
# Deploy with: docker compose -f compose.yaml -f compose.ollama.yaml up -d
#
# O1 is READ-ONLY: audit/plan/review only. implement/writer profiles are hard
# refused before inference. No model default, no :latest, fail closed on any
# missing var when enabled.
# ---------------------------------------------------------------------------

# Full Ollama image reference — MUST be digest-qualified with `@sha256:`.
# Version tags alone are mutable and are refused by unattended production recovery.
# Example: OLLAMA_IMAGE=ollama/ollama@sha256:<digest>
OLLAMA_IMAGE=<repository>@sha256:<64-lowercase-hex>

# Model qualifier — must be set when Ollama backend enabled. No default, no :latest.
# This is the model identifier passed to the Ollama API (e.g., a specific version tag).
# OWNER-APPROVED PRIMARY MODEL (Q1D-qualified): qwen3.5:4b-q4_K_M
# No material degradation observed in the bounded O1 qualification suite.
# Capacity reserve: qwen3.5:9b-q4_K_M ; Qualified alternate: ministral-3:8b-instruct-2512-q4_K_M
OLLAMA_MODEL_QUALIFIER=qwen3.5:4b-q4_K_M

# Generic helper image for Ollama read operations. Must be explicit when Ollama
# is enabled; AGENT_RUNNER_IMAGE is NOT used as an implicit fallback.
# Must be an immutable deployment image pin — same commit as EXECUTOR_IMAGE.
AGENT_HELPER_IMAGE=quarangate:executor-<full reviewed commit sha>

# O1 staging image (Git-capable trusted image for workspace staging)
# - Must be locally qualified and explicitly selected by the executor operator
# - Must use an immutable qualified reference; never :latest
# - Not caller-selectable
# - No fallback to AGENT_RUNNER_IMAGE (Kiro infrastructure)
# - No fallback to AGENT_HELPER_IMAGE (O1 read-only helper)
# - Executor startup fails if missing when Ollama is enabled
AGENT_STAGER_IMAGE=<SET_QUALIFIED_GIT_CAPABLE_STAGER_IMAGE>

# Ollama inference context window length (tokens). No default; must be sized
# to the model and available VRAM before enabling O1.
# Accepted values for this workstation are documented in docs/operations/OPERATIONS.md
# and must NOT become portable defaults here.
OLLAMA_CONTEXT_LENGTH=<SET_CONTEXT_LENGTH>

# NVIDIA device ID passed to the Ollama container's GPU reservation.
# Accepted values for this workstation are documented in docs/operations/OPERATIONS.md
# and must NOT become portable defaults here.
# Example form: "0"
OLLAMA_GPU_DEVICE=<SET_GPU_DEVICE>

# CPU and memory hard limits for the Ollama container (Docker Compose resource caps).
# Accepted values for this workstation are documented in docs/operations/OPERATIONS.md
# and must NOT become portable defaults here.
# Examples: OLLAMA_CPU_LIMIT=4.0  OLLAMA_MEM_LIMIT=12g  OLLAMA_PIDS_LIMIT=128
OLLAMA_CPU_LIMIT=<SET_CPU_LIMIT>
OLLAMA_MEM_LIMIT=<SET_MEM_LIMIT>
OLLAMA_PIDS_LIMIT=<SET_PIDS_LIMIT>

# ---------------------------------------------------------------------------
# Optional P7 I2 IDE Session Control (VS Code Remote-WSL, review-only source).
# Enable only with:
#   docker compose -f compose.yaml -f compose.ide.yaml ...
#
# This MUST be an existing absolute canonical WSL directory, not a symlink,
# owned by the same numeric Unix uid as both the Remote-WSL extension host and
# the executor runtime user, mode exactly 0700. The IDE overlay bind-mounts it
# into the executor at this exact same absolute pathname with
# create_host_path=false. No default is provided and no username/home path is
# hard-coded in production source.
#
# Owner setup example (choose your own trusted path):
#   install -d -m 0700 "$QUARANGATE_IDE_RUNTIME_ROOT"
# Then copy config/ide-sessions.example.yaml to config/ide-sessions.yaml and
# replace all enrollment identities with mechanically derived trusted values.
# The extension machine setting quarangate.runtimeCredentialPath is then:
#   <QUARANGATE_IDE_RUNTIME_ROOT>/<runtimeInstanceId>/credential.json
# Secret bytes remain only inside that 0600 credential file.
QUARANGATE_IDE_RUNTIME_ROOT=<absolute canonical owner-only WSL runtime directory>
