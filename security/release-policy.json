{
  "schemaVersion": 1,
  "requiredGates": [
    "typecheck",
    "build",
    "unit",
    "integration",
    "e2e",
    "authority-invariants",
    "security-fuzz",
    "sast",
    "secrets",
    "sca",
    "config-scan",
    "image-scan",
    "sbom",
    "provenance"
  ],
  "expectedTools": {
    "typecheck": {
      "name": "typescript",
      "version": "5.9.3"
    },
    "build": {
      "name": "typescript",
      "version": "5.9.3"
    },
    "unit": {
      "name": "vitest",
      "version": "3.2.7"
    },
    "integration": {
      "name": "vitest",
      "version": "3.2.7"
    },
    "e2e": {
      "name": "@playwright/test",
      "version": "1.63.0"
    },
    "authority-invariants": {
      "name": "quarangate-security-invariants",
      "version": "1"
    },
    "sast": {
      "name": "semgrep",
      "version": "1.177.0"
    },
    "secrets": {
      "name": "gitleaks",
      "version": "8.30.0"
    },
    "sca": {
      "name": "osv-scanner",
      "version": "2.6.0"
    },
    "config-scan": {
      "name": "trivy",
      "version": "0.74.0"
    },
    "image-scan": {
      "name": "trivy",
      "version": "0.74.0"
    },
    "sbom": {
      "name": "quarangate-release-sbom",
      "version": "2"
    },
    "provenance": {
      "name": "cosign",
      "version": "3.1.3"
    },
    "security-fuzz": {
      "name": "quarangate-security-fuzz",
      "version": "1"
    }
  },
  "findingPolicy": {
    "alwaysBlockSeverities": [
      "CRITICAL"
    ],
    "baselineEligibleSeverities": [
      "HIGH"
    ],
    "alwaysBlockCategories": [
      "authority",
      "integrity",
      "secret"
    ]
  },
  "exceptionPolicy": {
    "requireOwnerApproval": true,
    "requireExpiry": true,
    "requireReason": true
  },
  "gateContracts": {
    "e2e": {
      "state": "INTEGRATED",
      "passAllowed": true
    }
  }
}
