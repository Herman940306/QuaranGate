{
  "name": "quarangate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone MCP gateway bridging approved MCP clients to explicitly authorized Docker target containers",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gateway": "node dist/gateway/index.js",
    "executor": "node dist/executor/index.js",
    "test": "node scripts/run-vitest-clean.mjs tests/unit",
    "test:integration": "node scripts/run-vitest-clean.mjs tests/integration --no-file-parallelism",
    "deps:prepare": "node scripts/npm-offline-bundle.mjs prepare",
    "deps:verify": "node scripts/npm-offline-bundle.mjs verify",
    "build:offline-acceptance": "node scripts/accept-npm-offline-build.mjs",
    "gen-key": "node scripts/gen-client-key.mjs",
    "revoke-key": "node scripts/revoke-client.mjs",
    "validate-config": "node scripts/validate-config.mjs",
    "test:console": "node scripts/run-vitest-clean.mjs tests/unit/console-*.test.ts",
    "test:p9": "node scripts/run-vitest-clean.mjs tests/unit/p9-*.test.ts tests/integration/p9-*.test.ts --no-file-parallelism",
    "installer:plan": "node dist/installer/cli.js plan",
    "security:invariants": "node scripts/security-invariants.mjs",
    "release:sbom": "node scripts/release-sbom.mjs",
    "security:toolchain": "node scripts/security-toolchain.mjs",
    "release:policy": "node scripts/release-security-policy.mjs",
    "release:evidence-bundle": "node scripts/release-evidence-bundle.mjs",
    "release:source-binding": "node scripts/release-source-binding.mjs",
    "release:scan-receipt": "node scripts/release-scan-receipt.mjs",
    "release:gate-receipt": "node scripts/release-gate-receipt.mjs",
    "release:provenance": "node scripts/release-provenance.mjs",
    "release:assurance": "node scripts/release-assurance.mjs",
    "security:fuzz": "node scripts/security-fuzz.mjs --build",
    "security:egress": "node scripts/run-vitest-clean.mjs tests/unit/sh10 --no-file-parallelism",
    "security:prompt-injection": "node scripts/run-vitest-clean.mjs tests/unit/sh12 --no-file-parallelism",
    "release:system-e2e:validate": "node scripts/p10-system-e2e-evidence.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "ollama": "0.6.3",
    "tar-stream": "^3.1.7",
    "undici": "^7.10.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
